# Reference only: the application reads process environment variables.
# It does not load this file automatically. Set these values in your shell.
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/firebase-admin.json
GOOSE_DRIVER=postgres
# Set GOOSE_DBSTRING to the same value as DATABASE_URL in your shell.
GOOSE_DBSTRING=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
